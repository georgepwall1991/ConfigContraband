<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Top-level sample types and the instance-shaped direct-read example are intentional. IDE0005
         needs documentation-file generation to run, which this non-packable showcase does not need. -->
    <NoWarn>$(NoWarn);CA1050;CA1822;IDE0005</NoWarn>
    <!-- The showcase deliberately emits exactly one of every ConfigContraband diagnostic. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CFG001;CFG002;CFG003;CFG004;CFG005;CFG006;CFG007;CFG008;CFG009</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference both the analyzer and its Core dependency as analyzers so the analyzer load context
         can resolve ConfigContraband.Core at design/build time (the NuGet package bundles both DLLs). -->
    <ProjectReference Include="..\..\src\ConfigContraband.Core\ConfigContraband.Core.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\ConfigContraband\ConfigContraband.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <AdditionalFiles Include="appsettings.json;appsettings.*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
  </ItemGroup>

</Project>
